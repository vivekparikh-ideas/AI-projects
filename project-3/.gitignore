.venv/
__pycache__/
*.egg-info/
.pytest_cache/
runs/
.env
.cache/
fund.yaml

# Promo video and its render script (local marketing asset, ~20 MB mp4)
design/promo/
*.mp4
*.wav
node_modules/

# Generated eval output (rerun with evals/run_evals.py). Only the accepted baseline is kept,
# so a fresh clone can compare new runs with it. After `report.py --accept`, update the two run lines.
evals/results/*
!evals/results/BASELINE
!evals/results/2026-11-06-1911.json
!evals/results/2026-11-06-1911.html

# Secrets: keep any .env.example, ignore every other variant
.env.*
!.env.example

# Tooling and OS noise
.DS_Store
.vscode/
.idea/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
*.log
.vercel
