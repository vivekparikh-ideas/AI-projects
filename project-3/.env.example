# Backend (Vercel project env vars; locally in .env)
ANTHROPIC_API_KEY=
NEXUS_SEC_USER_AGENT="Nexus Research you@example.com"
DATABASE_URL=            # Supabase → Connect → Transaction pooler (port 6543)
SUPABASE_URL=            # https://<project>.supabase.co
SUPABASE_PUBLISHABLE_KEY= # Supabase → API keys → publishable key (SUPABASE_ANON_KEY also accepted)
NEXUS_OWNER_EMAILS=      # your email; only these can sign in
NEXUS_CACHE_DIR=/tmp/nexus-cache
LANGSMITH_TRACING=        # true to send traces (full prompts, tokens, cost) to LangSmith; unset = off
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=nexus
# Frontend (same values, exposed to the browser on purpose: they are public by design)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
